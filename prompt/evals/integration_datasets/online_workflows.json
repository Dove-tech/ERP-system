  "cases": [
    {
      "id": "hc_01_single_inventory_lookup",
      "category": "happy",
      "scenario": "单工具库存查询：用户只想查一个产品的库存。",
      "natural_language": "查询产品 1001 的当前库存",
      "request": {
        "query": "查询产品 1001 的当前库存",
        "isCopilot": true,
        "isContext": false
      },
      "human_simulation": [
        {
          "when": "tool_execution_confirm",
          "expected_tool": "query_inventory",
          "expected_params": {
            "productId": 1001
          },
          "feedback": "立即执行",
          "expected_intent": "confirm"
        }
      ],
      "expected": {
        "task_status": "completed",
        "operation_sequence": [
          {
            "tool": "ask_user_confirmation",
            "params": {
              "productId": 1001
            }
          },
          {
            "tool": "query_inventory",
            "params": {
              "productId": 1001
            },
            "requires_confirmation": true
          }
        ],
        "required_result_facts": [
          "库存"
        ],
        "final_answer_contains": [
          "库存"
        ]
      }
    },
