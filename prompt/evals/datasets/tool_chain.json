{
  "name": "tool_chain",
  "description": "Multi-tool ERP workflow replay cases.",
  "cases": [
    {
      "id": "chain_shortage_plan_adjustment",
      "query": "订单 O-9001 如果库存不足，就查供应商并调整生产计划",
      "model_steps": ["query_order", "query_inventory", "query_supplier", "update_plan"],
      "expected": {
        "steps": ["query_order", "query_inventory", "query_supplier", "update_plan"]
      }
    },
    {
      "id": "chain_progress_update",
      "query": "把生产订单 PO-7788 的进度更新为生产中",
      "model_steps": ["query_order", "update_status"],
      "expected": {
        "steps": ["query_order", "update_status"]
      }
    },
    {
      "id": "chain_bad_conditional_order_inventory_first",
      "query": "帮我查一下苹果还有多少，如果不够就下 50 件",
      "model_steps": ["query_product", "query_inventory", "ask_user_confirmation", "create_order"],
      "expected": {
        "steps": ["query_product", "query_inventory", "ask_user_confirmation", "create_order"]
      }
    },
    {
      "id": "chain_regression_simple_inventory_no_order",
      "query": "查一下苹果库存",
      "model_steps": ["query_inventory"],
      "expected": {
        "steps": ["query_inventory"]
      }
    }
  ]
}
